{
  "expo": {
    "name": "StreamVibe",
    "slug": "streamvibe",
    "version": "1.0.0",
    "icon": "./assets/images/streamvibe-app-icon.png",
    "orientation": "default",
    "scheme": "streamvibe",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141414",
    "android": {
      "package": "com.streamvibe.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/streamvibe-adaptive-foreground.png",
        "backgroundColor": "#141414"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.streamvibe.app",
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/images/streamvibe-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141414"
        }
      ],
      "expo-screen-orientation",
      "expo-secure-store",
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchitectures": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "61b70f92-15fa-4add-b2a2-907aab2abdc3"
      }
    }
  }
}
